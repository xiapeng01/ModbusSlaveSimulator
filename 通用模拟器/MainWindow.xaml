<Window x:Class="通用模拟器.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:通用模拟器"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="通用模拟器"
        Icon="Assets/app.ico"
        Height="740" Width="1180" MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{StaticResource WindowBackgroundBrush}"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome" CaptionHeight="48" ResizeBorderThickness="6"
                           GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>

    <Border x:Name="RootBorder" Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrandGradientBrush}">
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="通用模拟器" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Border CornerRadius="5" Padding="8,2" Margin="10,0,0,0"
                                Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="Modbus 从站" FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="Minimize_Click">
                            <Path Data="M0,0 L11,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" ToolTip="最大化" Click="Maximize_Click">
                            <Path Data="M0.8,0.8 L10.2,0.8 L10.2,10.2 L0.8,10.2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" ToolTip="关闭" Margin="0,0,6,0" Click="Close_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 网络列表 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="网络列表" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="导入" ToolTip="从文件导入参数（仅停止状态可用）" Margin="0,0,4,0"
                                            Command="{Binding ImportCommand}"
                                            MinHeight="24" Padding="8,0" FontSize="11.5" FontWeight="SemiBold"/>
                                    <Button Content="导出" ToolTip="将当前参数导出到文件" Margin="0,0,8,0"
                                            Command="{Binding ExportCommand}"
                                            MinHeight="24" Padding="8,0" FontSize="11.5" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource IconButton}" Content="+" ToolTip="新增网络"
                                            Command="{Binding AddNetworkCommand}"/>
                                    <Button Style="{StaticResource IconButtonDanger}" Content="−" ToolTip="删除网络" Margin="4,0,0,0"
                                            Command="{Binding RemoveNetworkCommand}"
                                            CommandParameter="{Binding ElementName=lvNetwork,Path=SelectedItem}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <ListView x:Name="lvNetwork" ItemsSource="{Binding NetworkList}" Margin="8"
                                      SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsEnable}" VerticalAlignment="Center"
                                                      ToolTip="启用/停用"/>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ProtocolType}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <!-- 括号内：RTU 显示串口号，TCP / RTU over TCP 显示端口号 -->
                                                    <TextBlock FontSize="11" Margin="3,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Port, StringFormat=({0})}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProtocolType}" Value="{x:Static local:EnumProtocolType.ModbusRtu}">
                                                                        <Setter Property="Text" Value="{Binding PortName, StringFormat=({0})}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- 该网络最近出错时显示红点（悬停查看原因） -->
                                                    <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                                             Fill="{StaticResource DangerBrush}" ToolTip="{Binding LastError}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6"
                                                    Padding="7,2" Background="{StaticResource PrimarySoftBrush}">
                                                <TextBlock Text="{Binding Tick}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="暂无网络配置&#x0a;点击右上角 + 新增一个网络"
                                       VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetworkList.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右侧详情 -->
                <Grid Grid.Column="1" Margin="14,0,0,0">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48">
                        <StackPanel>
                            <TextBlock Text="未选择网络" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="请在左侧选择或新增一个网络配置" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=lvNetwork, Path=SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding ElementName=lvNetwork,Path=SelectedItem}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=lvNetwork, Path=SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate d:DataType="local:NetworkConfigModel">
                                    <StackPanel>
                                        <!-- 网络配置 -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="网络配置" Style="{StaticResource SectionTitle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="启用" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <CheckBox IsChecked="{Binding IsEnable}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid IsEnabled="{Binding CanEdit}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="88"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FormLabel}"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="协议类型" Style="{StaticResource FormLabel}"/>
                                                    <ComboBox Grid.Row="0" Grid.Column="4" SelectedValue="{Binding ProtocolType}" ItemsSource="{Binding ProtocolTypeValues}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP 地址" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsTcpMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IP, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"
                                                             Visibility="{Binding IsTcpMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="端口" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsTcpMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"
                                                             Visibility="{Binding IsTcpMode, Converter={StaticResource BoolToVisibility}}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="串口号" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding PortName}" ItemsSource="{Binding PortNameValues}" Margin="0,10,0,0"
                                                              DropDownOpened="PortName_DropDownOpened"
                                                              Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="波特率" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="4" SelectedValue="{Binding BaudRate}" ItemsSource="{Binding BaudRateValues}" Margin="0,10,10,0"
                                                              Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="数据位" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding DataBits}" ItemsSource="{Binding DataBitsValues}" Margin="0,10,0,0"
                                                              Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="校验位" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ComboBox Grid.Row="2" Grid.Column="4" SelectedValue="{Binding Parity}" ItemsSource="{Binding ParityValues}" Margin="0,10,0,0"
                                                              Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="停止位" Style="{StaticResource FormLabel}" Margin="0,10,10,0"
                                                               Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ComboBox Grid.Row="3" Grid.Column="4" SelectedValue="{Binding StopBits}" ItemsSource="{Binding StopBitsValues}" Margin="0,10,0,0"
                                                              Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="刷新间隔(ms)" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding IntervalValues}" Margin="0,10,0,0"/>

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="备注" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>

                                                    <!-- 运行状态（只读），与上方配置区分隔 -->
                                                    <Border Grid.Row="5" Grid.ColumnSpan="5" Height="1" Margin="0,16,0,0"
                                                            Background="{StaticResource BorderBrush}" SnapsToDevicePixels="True"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="心跳计数" Style="{StaticResource FormLabel}" Margin="0,14,10,0"/>
                                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Tick}" IsReadOnly="True" Margin="0,14,0,0"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="3" Text="站点数量" Style="{StaticResource FormLabel}" Margin="0,14,10,0"/>
                                                    <Border Grid.Row="6" Grid.Column="4" Margin="0,14,0,0" CornerRadius="6"
                                                            Background="{StaticResource SurfaceAltBrush}" Height="32">
                                                        <TextBlock Text="{Binding StationList.Count}" Margin="12,0,0,0"
                                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 站点 -->
                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="站点列表" Style="{StaticResource SectionTitle}"/>
                                                        <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" Background="{StaticResource SurfaceAltBrush}">
                                                            <TextBlock Text="{Binding StationList.Count}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource IconButton}" Content="+" ToolTip="新增站点"
                                                                Command="{Binding AddStationCommand}" IsEnabled="{Binding CanEdit}"/>
                                                        <Button Style="{StaticResource IconButtonDanger}" Content="−" ToolTip="删除站点" Margin="4,0,0,0"
                                                                Command="{Binding RemoveStationCommand}"
                                                                CommandParameter="{Binding ElementName=lvStation,Path=SelectedValue}"
                                                                IsEnabled="{Binding CanEdit}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" CornerRadius="8" Padding="6"
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <ListView x:Name="lvStation" ItemsSource="{Binding StationList}" MouseDoubleClick="lvStation_MouseDoubleClick"
                                                                      SelectedItem="{Binding SelectedStation, Mode=TwoWay}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <CheckBox IsChecked="{Binding IsEnable}" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,0,0"
                                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6"
                                                                                    Padding="6,1" Background="{StaticResource SurfaceBrush}">
                                                                                <TextBlock Text="{Binding Tick}" FontSize="11"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                            <TextBlock Text="暂无站点" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StationList.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Grid.Column="1" Margin="14,0,0,0">
                                                        <Border CornerRadius="8" Padding="14" Background="{StaticResource SurfaceAltBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="选择左侧站点以编辑" Style="{StaticResource HintText}"/>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=lvStation, Path=SelectedValue}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <ContentControl Content="{Binding ElementName=lvStation,Path=SelectedValue}"
                                                                        IsEnabled="{Binding CanEdit}">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=lvStation, Path=SelectedValue}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate d:DataType="local:StationInformationModel">
                                                                    <StackPanel>
                                                                        <!-- ===== 站点信息 ===== -->
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FormLabel}"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="站号" Style="{StaticResource FormLabel}"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding StationNo, UpdateSourceTrigger=PropertyChanged}"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="字节序" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Endian}" ItemsSource="{Binding EndialValues}" Margin="0,10,0,0"/>
                                                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="间隔时间" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                            <ComboBox Grid.Row="1" Grid.Column="4" SelectedValue="{Binding Interval}" ItemsSource="{Binding IntervalValues}" IsReadOnly="True" Margin="0,10,0,0"/>

                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="备注" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>

                                                                            <!-- 运行状态（只读），与上方配置区分隔 -->
                                                                            <Border Grid.Row="3" Grid.ColumnSpan="5" Height="1" Margin="0,16,0,0"
                                                                                    Background="{StaticResource BorderBrush}" SnapsToDevicePixels="True"/>

                                                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="心跳计数" Style="{StaticResource FormLabel}" Margin="0,14,10,0"/>
                                                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Tick}" IsReadOnly="True" Margin="0,14,0,0"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="规则数量" Style="{StaticResource FormLabel}" Margin="0,14,10,0"/>
                                                                            <Border Grid.Row="4" Grid.Column="4" Margin="0,14,0,0" CornerRadius="6"
                                                                                    Background="{StaticResource SurfaceAltBrush}" Height="32">
                                                                                <TextBlock Text="{Binding RulerList.Count}" Margin="12,0,0,0"
                                                                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </Grid>

                                                                        <!-- ===== 数据规则 ===== -->
                                                                        <Border Margin="0,16,0,0" CornerRadius="8" Padding="14"
                                                                                Background="{StaticResource SurfaceAltBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                                            <StackPanel>
                                                                                <Grid Margin="0,0,0,10">
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                                                                        <TextBlock Text="数据规则" Style="{StaticResource SectionTitle}"/>
                                                                                        <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" Background="{StaticResource SurfaceBrush}">
                                                                                            <TextBlock Text="{Binding RulerList.Count}" FontSize="11" FontWeight="SemiBold"
                                                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                                        <Button Style="{StaticResource IconButton}" Content="+" ToolTip="新增规则"
                                                                                                Command="{Binding AddRulerCommand}"/>
                                                                                        <Button Style="{StaticResource IconButtonDanger}" Content="−" ToolTip="删除规则" Margin="4,0,0,0"
                                                                                                Command="{Binding RemoverRulerCommand}"
                                                                                                CommandParameter="{Binding ElementName=lvRuler, Path=SelectedItem}"/>
                                                                                    </StackPanel>
                                                                                </Grid>

                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="200"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- 规则列表 -->
                                                                                    <Border Grid.Column="0" CornerRadius="8" Padding="6" Background="{StaticResource SurfaceBrush}"
                                                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                                                        <Grid>
                                                                                            <ListView x:Name="lvRuler" ItemsSource="{Binding RulerList}"
                                                                                                      SelectedItem="{Binding SelectedRuler, Mode=TwoWay}">
                                                                                                <ListView.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <Grid>
                                                                                                            <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                            </Grid.ColumnDefinitions>
                                                                                                            <CheckBox IsChecked="{Binding IsEnable}" VerticalAlignment="Center" ToolTip="启用/停用"/>
                                                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                                <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                                                                                                    <TextBlock.Text>
                                                                                                                        <MultiBinding StringFormat="{}{0} @ {1}">
                                                                                                                            <Binding Path="DataType"/>
                                                                                                                            <Binding Path="StartAddress"/>
                                                                                                                        </MultiBinding>
                                                                                                                    </TextBlock.Text>
                                                                                                                </TextBlock>
                                                                                                            </StackPanel>
                                                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                                                                <Border CornerRadius="6" Padding="6,1" HorizontalAlignment="Right"
                                                                                                                        Background="{StaticResource PrimarySoftBrush}" ToolTip="数量">
                                                                                                                    <TextBlock Text="{Binding Length}" FontSize="11" FontWeight="SemiBold"
                                                                                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                                                                                </Border>
                                                                                                                <TextBlock Text="{Binding Tick}" FontSize="10.5" Margin="0,3,0,0"
                                                                                                                           HorizontalAlignment="Right" ToolTip="写入次数"
                                                                                                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                                                                                            </StackPanel>
                                                                                                        </Grid>
                                                                                                    </DataTemplate>
                                                                                                </ListView.ItemTemplate>
                                                                                            </ListView>
                                                                                            <TextBlock Text="暂无规则&#x0a;点击右上角 + 新增" TextWrapping="Wrap" VerticalAlignment="Center">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding RulerList.Count}" Value="0">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Grid>
                                                                                    </Border>

                                                                                    <!-- 规则属性 -->
                                                                                    <Grid Grid.Column="1" Margin="14,0,0,0">
                                                                                        <Border CornerRadius="8" Padding="14" Background="{StaticResource SurfaceBrush}"
                                                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                            <TextBlock Text="选择左侧规则以编辑" Style="{StaticResource HintText}"/>
                                                                                            <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding ElementName=lvRuler, Path=SelectedValue}" Value="{x:Null}">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Border.Style>
                                                                                        </Border>

                                                                                        <ContentControl Content="{Binding ElementName=lvRuler, Path=SelectedValue}">
                                                                                            <ContentControl.Style>
                                                                                                <Style TargetType="ContentControl">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding ElementName=lvRuler, Path=SelectedValue}" Value="{x:Null}">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </ContentControl.Style>
                                                                                            <ContentControl.ContentTemplate>
                                                                                                <DataTemplate d:DataType="local:RulerModel">
                                                                                                    <Grid>
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                            <ColumnDefinition Width="68"/>
                                                                                                            <ColumnDefinition Width="*"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <Grid.RowDefinitions>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                            <RowDefinition Height="Auto"/>
                                                                                                        </Grid.RowDefinitions>

                                                                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FormLabel}"/>
                                                                                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                                                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="寄存器类型" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding RegisterType}" ItemsSource="{Binding RegisterTypeValues}" Margin="0,10,0,0"/>
                                                                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="数据类型" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding DataType}" ItemsSource="{Binding DataTypeValues}" Margin="0,10,0,0"/>

                                                                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="起始地址" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
                                                                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="数量" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>

                                                                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="备注" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>

                                                                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="写入次数" Style="{StaticResource FormLabel}" Margin="0,10,10,0"/>
                                                                                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Tick}" IsReadOnly="True" Margin="0,10,0,0"/>
                                                                                                    </Grid>
                                                                                                </DataTemplate>
                                                                                            </ContentControl.ContentTemplate>
                                                                                        </ContentControl>
                                                                                    </Grid>
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ============ 底部状态栏 ============ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.25" Duration="0:0:0.9"
                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="已停止"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="运行中"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="16,0"/>
                        <TextBlock Text="{Binding NetworkList.Count, StringFormat='网络数：{0}'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=lvNetwork, Path=SelectedItem.LastError}"
                                   FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ElementName=lvNetwork, Path=SelectedItem.LastError}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=lvNetwork, Path=SelectedItem.LastError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SuccessButton}" Content="启 动" Width="120" Height="38"
                                Command="{Binding StartCommand}" IsEnabled="{Binding IsStopped}"/>
                        <Button Style="{StaticResource DangerButton}" Content="停 止" Width="120" Height="38" Margin="10,0,0,0"
                                Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
