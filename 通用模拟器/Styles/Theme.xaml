<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ 配色 ============ -->
    <Color x:Key="PrimaryColor">#FF4F46E5</Color>
    <Color x:Key="PrimaryLightColor">#FF6366F1</Color>
    <Color x:Key="PrimaryDarkColor">#FF4338CA</Color>
    <Color x:Key="PrimarySoftColor">#FFEEF2FF</Color>

    <Color x:Key="SuccessColor">#FF10B981</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>
    <Color x:Key="DangerDarkColor">#FFDC2626</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>

    <Color x:Key="WindowBackgroundColor">#FFF4F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF8FAFC</Color>
    <Color x:Key="SurfaceHoverColor">#FFF1F5F9</Color>
    <Color x:Key="SurfacePressedColor">#FFE2E8F0</Color>

    <Color x:Key="BorderColor">#FFE2E8F0</Color>
    <Color x:Key="BorderStrongColor">#FFCBD5E1</Color>

    <Color x:Key="TextPrimaryColor">#FF0F172A</Color>
    <Color x:Key="TextSecondaryColor">#FF64748B</Color>
    <Color x:Key="TextTertiaryColor">#FF94A3B8</Color>

    <!-- ============ 画笔 ============ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6366F1" Offset="0"/>
        <GradientStop Color="#FF2563EB" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ 通用尺寸 ============ -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

    <!-- ============ 阴影 ============ -->
    <DropShadowEffect x:Key="CardShadow" Color="#1A0F172A" BlurRadius="18" ShadowDepth="0" Opacity="0.06" Direction="270"/>
    <DropShadowEffect x:Key="PopupShadow" Color="#260F172A" BlurRadius="22" ShadowDepth="0" Opacity="0.14" Direction="270"/>

</ResourceDictionary>
