<Window x:Class="通用模拟器.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:通用模拟器"
        mc:Ignorable="d"
        Title="写入寄存器"
        Height="700" Width="620" MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{StaticResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrandGradientBrush}">
                            <TextBlock Text="W" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="写入寄存器" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Border CornerRadius="5" Padding="8,2" Margin="10,0,0,0"
                                Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="站号 {0}">
                                        <Binding Path="StationNo" TargetNullValue="-"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarCloseButton}" ToolTip="关闭" Margin="0,0,6,0" Click="Close_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 主体 ============ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">

                    <!-- 目标站点 -->
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimarySoftBrush}">
                                <TextBlock Text="站" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name, TargetNullValue='未选择站点'}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description, TargetNullValue='向该站点写入寄存器数据'}" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 参数 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <!-- 套用已有规则 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="套用规则" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Column="1" x:Name="cbRuler" ItemsSource="{Binding RulerList}"
                                          DisplayMemberPath="Name" SelectionChanged="cbRuler_SelectionChanged"
                                          ToolTip="选择站点已有规则，自动填充寄存器类型、数据类型与起始地址"/>
                            </Grid>

                            <!-- 寄存器类型 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="寄存器类型" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <Border CornerRadius="8" Padding="3" Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Name="rbReadOnly" Content="只读" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbReadWrite" Content="读写" IsChecked="True" Style="{StaticResource SegmentedRadioButton}"/>
                                </StackPanel>
                            </Border>

                            <!-- 数据类型 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,0,10">
                                <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="数据类型" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <Border CornerRadius="8" Padding="6" Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <WrapPanel>
                                    <RadioButton Name="rbBool" Content="Bool" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbInt16" Content="Int16" IsChecked="True" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbUInt16" Content="UInt16" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbInt32" Content="Int32" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbUInt32" Content="UInt32" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbFloat" Content="Float" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                    <RadioButton Name="rbString" Content="String" Margin="0,0,6,6" Style="{StaticResource SegmentedRadioButton}"/>
                                </WrapPanel>
                            </Border>

                            <!-- 起始地址 -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="起始地址" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="1" Name="tbAddress" Text="0"
                                         ToolTip="写入的起始寄存器地址"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 发送内容 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="发送内容" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                                <TextBlock Text="多个值用 , 或 ; 分隔" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right" Margin="0"/>
                            </Grid>
                            <TextBox Name="tbSendContent" Style="{StaticResource EditorTextBox}"
                                     Height="150" VerticalContentAlignment="Top"
                                     ToolTip="例如：1,2,3 或 true,false"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 底部操作栏 ============ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关 闭" Width="96" Height="36" Click="Close_Click"/>
                    <Button Content="发 送" Width="120" Height="36" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Send_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
